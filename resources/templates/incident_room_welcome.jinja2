{% macro row(label, value) -%}
<tr><td style="width:140px;padding:4px 0;color:#1A1A1A;"><b>{{ label }}</b></td><td style="padding:4px 0;color:#1A1A1A;">{{ value }}</td></tr>
{%- endmacro %}
<messageML>
    <div style="background:#FFFFFF;border:1px solid #E0E0E0;border-radius:8px;box-shadow:0 2px 8px rgba(0,0,0,0.18);overflow:hidden;max-width:480px;">
        <table style="border:0px solid transparent;width:100%;">
            <tr>
                <td style="background:#3B1E5F;color:#FFFFFF;padding:10px 14px;"><b>Incident Room - {{ ticket_id }}</b></td>
            </tr>
        </table>

        <div style="padding:14px;color:#1A1A1A;">
            <p>Hi <mention uid="{{ requester_user_id }}"/>, thanks for flagging this. We've created this room to help resolve the issue you raised against Message Rate Control ticket <b>{{ ticket_id }}</b>.</p>

            <div style="background:#FFF4E5;border-left:4px solid #B76E00;padding:10px 14px;color:#7A4B00;margin:14px 0;">
                <b>Topic:</b> {{ topic_label }}<br/>
                <b>Details:</b> {{ details }}
            </div>

            <hr/>
            <p><b>Original ticket context</b></p>
            <table style="border:0px solid transparent;width:100%;">
                {{ row("Trader", trader) }}
                {{ row("Algo Name", algo_name) }}
                {{ row("Instrument", instrument) }}
                {{ row("Entity", entity) }}
                {{ row("Flow", flow) }}
                {{ row("Breach reason", reason) }}
            </table>

            <p>A member of the Trading Surveillance team will join shortly to help resolve this.</p>
        </div>
    </div>
</messageML>
